@@ -0,0 +1,14 @@
+use std::{env, path::PathBuf};
+
+fn main() {
+    let target = env::var("TARGET").expect("TARGET is required");
+    let manifest_dir = PathBuf::from(env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR is required"));
+    let easytier_root = manifest_dir
+        .parent()
+        .and_then(|p| p.parent())
+        .expect("easytier root");
+    let release_dir = easytier_root.join("target").join(target).join("release");
+
+    println!("cargo:rustc-link-search=native={}", release_dir.display());
+    println!("cargo:rustc-link-lib=dylib=easytier_ffi");
+}
