index 5fdb460..a3ac0ac 100644
--- a/src/winpcap.rs
+++ b/src/winpcap.rs
@@ -336,6 +336,27 @@ pub fn interfaces() -> Vec<NetworkInterface> {
         }
     }
 
+    // ==== MCTier patch: never abort the process over a missing Packet.dll ====
+    //
+    // Upstream `panic!`s when `PacketGetAdapterNames` fails twice. That is fatal
+    // here for two reasons: EasyTier builds the release profile with
+    // `panic = "abort"`, so the panic cannot be contained by the
+    // `catch_unwind(pnet::datalink::interfaces)` guards upstream code wraps this
+    // call in; and without `Packet.dll` the call *always* fails, so merely
+    // removing the static import would have traded a load-time 0xC0000135 for a
+    // run-time abort the moment any code enumerated interfaces.
+    //
+    // The adapter list itself comes from `GetAdaptersInfo` (iphlpapi, always
+    // present); `PacketGetAdapterNames` only supplies the pcap-visible subset
+    // used to filter it. So when Npcap is absent we return the unfiltered list
+    // instead: that is what MCTier's only Windows consumer of this function
+    // wants anyway (interface enumeration fallback), and any caller that goes on
+    // to open a datalink channel still gets a clean `io::Error` from
+    // `PacketOpenAdapter` returning null.
+    if !winpcap::packet_dll_is_available() {
+        return all_ifaces;
+    }
+
     let mut buf = vec![0u8; 4096];
     let mut buflen = buf.len() as u32;
 
@@ -343,10 +364,11 @@ pub fn interfaces() -> Vec<NetworkInterface> {
         buf.resize(buflen as usize, 0);
 
         // Second call should now work with the correct buffer size. If not, this may be
-        // due to some privilege or other unforeseen issue.
+        // due to some privilege or other unforeseen issue - degrade to the
+        // unfiltered list rather than taking the process down.
         if unsafe { winpcap::PacketGetAdapterNames(buf.as_mut_ptr() as *mut i8, &mut buflen) } == 0
         {
-            panic!("Unable to get interface list despite increasing buffer size");
+            return all_ifaces;
         }
     }
 
